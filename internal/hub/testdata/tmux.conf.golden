# generated by zenify hub — edits are overwritten
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g escape-time 10
set -g focus-events on
set -g set-clipboard on
setw -gq allow-passthrough on
set -g status-position top
set -g status-left ' zenify hub '
set -g status-right ' [+ agent] '
setw -g window-status-format ' #{?@hub_state,#{@hub_state} ,}#W '
setw -g window-status-current-format '#[reverse] #{?@hub_state,#{@hub_state} ,}#W #[noreverse]'
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-1 select-window -t :=1
bind -n M-2 select-window -t :=2
bind -n M-3 select-window -t :=3
bind -n M-4 select-window -t :=4
bind -n M-5 select-window -t :=5
bind -n M-6 select-window -t :=6
bind -n M-7 select-window -t :=7
bind -n M-8 select-window -t :=8
bind -n M-9 select-window -t :=9
bind -n M-n run-shell -b "'/Users/John Doe/it'\\''s/##zen\$ify' hub new-agent"
bind -n M-d detach-client
bind -n MouseDown1Status select-window -t =
bind -n MouseDown1StatusRight run-shell -b "'/Users/John Doe/it'\\''s/##zen\$ify' hub new-agent"

apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    service:
      spec:
        type: ClusterIP
        clusterIP: {{ .TraefikClusterIP }}
    # ClusterIP has no load-balancer status to publish; write the fixed IP into
    # every Ingress status instead, or ArgoCD never sees an Ingress Healthy.
    providers:
      kubernetesIngress:
        publishedService:
          enabled: false
    additionalArguments:
      - "--providers.kubernetesingress.ingressendpoint.ip={{ .TraefikClusterIP }}"
    ports:
      web:
        http:
          redirections:
            entryPoint:
              to: websecure
              scheme: https
              permanent: true

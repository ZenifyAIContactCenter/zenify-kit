apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Name }}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ .RepoURL }}
    path: charts/local-platform
    targetRevision: {{ printf "%q" .ChartRef }}
    helm:
      valueFiles:
        - ../../envs/local-platform/values.yaml
      valuesObject:
        domain: {{ printf "%q" .Domain }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .Namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true

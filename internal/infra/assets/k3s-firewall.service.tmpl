[Unit]
Description=Zenify firewall for the k3s API server and kubelet ports
Wants=network-pre.target
Before=network-pre.target k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ .NftPath }}
ExecStop=/usr/sbin/nft delete table inet {{ .Table }}

[Install]
WantedBy=multi-user.target

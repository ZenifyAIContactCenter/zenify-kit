#!/usr/bin/env bash
# Mechanical tier selection for znf:review (no LLM guessing).
# Input : ADDED_LOC (added+removed lines), SHARED (0|1 touches a shared contract), CRITICAL (0|1).
# Output: line 1 = T1|T2|T3 ; line 2 = reason: <why>.
# Rule: size never forces T3
#   CRITICAL=1           -> T3 regardless of size
#   else                 -> T1 <=200 | T2 >200
#   SHARED=1 floor       -> never below T2 (T2 already runs a `contracts` dimension)
set -euo pipefail

if [ $# -ne 3 ]; then
  echo "usage: select-tier ADDED_LOC SHARED CRITICAL" >&2
  exit 2
fi
loc=$1; shared=$2; critical=$3
case "$loc" in ''|*[!0-9]*) echo "ADDED_LOC must be a number: $loc" >&2; exit 2;; esac

if [ "$critical" = "1" ]; then
  echo "T3"; echo "reason: critical area -> adversarial verify regardless of size"
  exit 0
fi
if [ "$loc" -gt 200 ]; then
  echo "T2"; echo "reason: diff >200 LOC -> 5-dimension fan-out"
elif [ "$shared" = "1" ]; then
  echo "T2"; echo "reason: small diff touching a shared contract -> T2 floor (contracts dimension)"
else
  echo "T1"; echo "reason: small diff (<=200 LOC), no shared contract -> 1 reviewer"
fi
